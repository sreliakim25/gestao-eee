# Supabase — projeto da obra EEE Novo Mundo
# Copie para .env.local e preencha. O .env nunca vai para o Git.

# Públicas (expostas ao browser — apenas URL e anon key, protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor — NUNCA prefixar com NEXT_PUBLIC_.
# Usada apenas pelo script de import do cronograma (scripts/import-smartsheet.ts).
# No formato novo de chaves do Supabase, esta é a "secret key" (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres — usada SÓ por scripts/aplicar-schema.ts (DDL).
# ATENÇÃO: é a senha do banco, NÃO a chave de API. As chaves sb_publishable_/
# sb_secret_ acessam dados via PostgREST e não conseguem criar tabelas.
# Onde achar: Project Settings → Database → Connection string → aba URI.
# Se a senha tiver caracteres especiais, faça percent-encoding.
DATABASE_URL="postgresql://postgres:SENHA@db.SEU-REF.supabase.co:5432/postgres"

# Caminho do .xlsx exportado do Smartsheet (usado pelo script de import)
SMARTSHEET_XLSX_PATH=./Materiais/EEE - Novo Mundo.xlsx

# Opcional — Análise IA (Fase 7), somente servidor
ANTHROPIC_API_KEY=

# Smartsheet — sync do cronograma pela API (substitui o import por .xlsx).
# Token: Smartsheet → Personal Settings → API Access → Generate new access token.
# Sheet ID: npm run smartsheet:listar
SMARTSHEET_TOKEN=
SMARTSHEET_SHEET_ID=

# Segredo do cron agendado (/api/cron/sincronizar). A Vercel envia como
# Authorization: Bearer. Sem ele a rota recusa — falha fechada de propósito.
CRON_SECRET=
