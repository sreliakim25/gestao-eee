# Supabase — projeto da obra EEE Novo Mundo
# Copie para .env.local e preencha. O .env nunca vai para o Git.

# Públicas (expostas ao browser — apenas URL e anon key, protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor — NUNCA prefixar com NEXT_PUBLIC_.
# Usada apenas pelo script de import do cronograma (scripts/import-smartsheet.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Caminho do .xlsx exportado do Smartsheet (usado pelo script de import)
SMARTSHEET_XLSX_PATH=./Materiais/EEE - Novo Mundo.xlsx

# Opcional — Análise IA (Fase 7), somente servidor
ANTHROPIC_API_KEY=
